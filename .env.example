# Optional. MeteoChile WRF-DMC point forecasts require a personal token
# from climatologia.meteochile.gob.cl. Without these, the forecast page
# uses live Open-Meteo GFS (the same parent model WRF-DMC nests from).
METEOCHILE_USER=
METEOCHILE_TOKEN=

# Optional. 3D uses Cesium with OpenStreetMap tiles and needs no token.
# Set this only if you want Cesium ion imagery/terrain instead.
NEXT_PUBLIC_CESIUM_ION_TOKEN=
