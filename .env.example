# Optional. MeteoChile WRF-DMC point forecasts require a personal token
# from climatologia.meteochile.gob.cl. Without these, the forecast page
# uses live Open-Meteo GFS (the same parent model WRF-DMC nests from).
METEOCHILE_USER=
METEOCHILE_TOKEN=

# Optional. Cesium Ion World Terrain (never commit a real token).
CESIUM_ION_TOKEN=

# Optional. JSONL log for generated METAR/TAF (Step 4 scoring).
PRODUCT_LOG_PATH=./data/product-log.jsonl

# Andes ceiling grid (~0.1° default 27×18). Tune down if Open-Meteo is slow.
# ANDES_GRID_ROWS=18
# ANDES_GRID_COLS=27
# OPEN_METEO_BATCH_SIZE=60
# OPEN_METEO_BATCH_DELAY_MS=250
